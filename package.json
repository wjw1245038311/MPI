    "highlight.js": "^11.10.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "skills": "^1.7.0",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "mermaid": "^12.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.6.3",
    "unified": "^11.0.5",
    "vite": "^5.4.11",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.mpi.app",
    "productName": "MPI",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/skills/**",
      "**/node_modules/tar/**",
      "**/node_modules/yaml/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "wjw1245038311",
        "repo": "MPI",
        "releaseType": "release"
      }
    ],
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!**/*.map",
      "!**/node_modules/pdfjs-dist/**",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/highlight.js/**",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/third_party/**",
      "!**/node_modules/node-pty/deps/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "extraResources": [
      {
        "from": "resources/runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "runtime-release",
        "to": "runtime-package"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/user-manual.md",
        "to": "user-manual.md"
      },
      {
        "from": "resources/user-manual-en.md",
        "to": "user-manual-en.md"
      },
      {
        "from": "resources/memory-manual.md",
        "to": "memory-manual.md"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "executableName": "MPI",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MPI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "packElevateHelper": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MPI"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "MPI-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "MPI-${version}-${arch}.${ext}"
    }
  }
}
