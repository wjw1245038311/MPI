<?xml version="1.0" encoding="utf-8"?>
<!-- 根容器用 LinearLayout：自更新提示条必须**占位**而不是浮在 WebView 上——
     曾经的 layout_gravity="top" 覆盖会盖住网页标题/配置栏，用户只会以为「界面是旧的」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12141A"
    android:orientation="vertical">

    <!-- 自更新提示条：占位式（把 WebView 压下去），绝不覆盖网页内容 -->
    <LinearLayout
        android:id="@+id/updateBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B2A23"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DCE7E1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/updateAction"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/update_action"
            android:textColor="#9ECE6A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/updateClose"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="✕"
            android:textColor="#8B90A0"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 网页区：占满剩余高度，内部只有小型浮层（⋮ 菜单 / 加载 / 错误） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 壳菜单入口：WebView 没有地址栏/刷新按钮，页面若是旧版或地址存错就无从自救。
         常驻右上角（半透明，不挡正文），点开有「刷新页面 / 服务器地址 / 诊断」。 -->
    <TextView
        android:id="@+id/shellMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:alpha="0.35"
        android:background="#00000000"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/shell_menu_glyph"
        android:textColor="#E6E8EE"
        android:textSize="18sp" />


    <!-- 加载指示：启动后一直显示，直到首帧渲染完成（onPageFinished）或错误面板出现。
         没有它时「中继不可达」表现为纯黑屏零反馈——用户只会说“打开没反应”。 -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12141A"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shell_loading"
            android:textColor="#8B90A0"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Native fallback when the relay page cannot load: the only place the base
         URL can be edited (there is no settings screen in a one-view shell). -->
    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12141A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E6E8EE"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/shell_url_hint"
            android:inputType="textUri"
            android:textColor="#E6E8EE"
            android:textColorHint="#6B7280"
            android:textSize="14sp"
            android:autofillHints="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/shell_retry" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/shell_save" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
</LinearLayout>
