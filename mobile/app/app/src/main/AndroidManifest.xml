<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 语音输入（M4）：原生 AudioRecord 采集，不经 WebView -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 扫码配对（M4）：CameraX + ML Kit -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- 审批通知与后台保活（M5） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 后台/锁屏播报保活：回合在跑时防 CPU 睡 / Doze（见 TurnWakeLock） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 后台保活引导：请求系统把本应用移出电池优化名单（见 KeepAliveGuide）。
         用户需在系统弹窗里手动确认，安装时不自动授予。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 自更新（M6）：下载新 APK 后调系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mpi">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：仅保活（让连接与事件监听在后台不被回收） -->
        <service
            android:name=".data.MpiLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 身体层（手机操控）：跑在 :body 进程，与大脑（:agent / :main）隔离。
             系统只讣一个这样的服务，两个大脑都通过 LocalSocket 連它。 -->
        <service
            android:name=".body.MpiA11yService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":body">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/body_accessibility" />
        </service>

        <!-- 身体层调试页：同进程，用来验证「这一屏能读到什么」 -->
        <activity
            android:name=".body.BodyDebugActivity"
            android:exported="false"
            android:label="手机操控调试"
            android:process=":body" />

        <!-- 自更新：把 cacheDir 里的 APK 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
