{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["src/main", "src/preload/index.ts", "electron.vite.config.ts"],
  // The bridge extensions are consumed only as `?raw` strings (todo-extension.ts /
  // choice-extension.ts / channel-extension.ts) and transpiled by pi's own jiti
  // loader at runtime, which aliases typebox / @earendil-works/pi-coding-agent to
  // its bundled copies. They are not part of MPI's compile graph — those imports
  // don't exist in our node_modules.
  "exclude": [
    "src/main/mpi-todo-ext.ts",
    "src/main/mpi-choice-ext.ts",
    "src/main/mpi-taskmode-ext.ts",
    "src/main/messaging/channel-command-ext.ts"
  ]
}
