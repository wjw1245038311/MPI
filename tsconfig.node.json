{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["src/main", "src/preload/index.ts", "electron.vite.config.ts"],
  // The todo bridge extension is consumed only as a `?raw` string (todo-extension.ts)
  // and transpiled by pi's own jiti loader at runtime, which aliases typebox /
  // @earendil-works/pi-coding-agent to its bundled copies. It is not part of MPI's
  // compile graph — those imports don't exist in our node_modules.
  "exclude": ["src/main/mpi-todo-ext.ts"]
}
